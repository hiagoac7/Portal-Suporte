# Classify authored application code and auxiliary Windows automation.
*.py linguist-language=Python linguist-detectable=true
*.pyw linguist-language=Python linguist-detectable=true
app/static/global.css linguist-language=CSS linguist-detectable=true
app/static/*.js linguist-language=JavaScript linguist-detectable=true
app/static/*.html linguist-language=HTML linguist-detectable=true
*.ps1 linguist-language=PowerShell linguist-detectable=true
*.bat linguist-language=Batchfile linguist-detectable=true
*.vbs linguist-language=VBScript linguist-detectable=true

# Streamlit's configuration is TOML: include the real configuration format.
.streamlit/config.toml linguist-language=TOML linguist-detectable=true

# Windows Explorer's desktop.ini is OS metadata, not application source.
desktop.ini linguist-generated=true
